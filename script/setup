#!/usr/bin/env bash

# Bootstraps a machine from scratch: installs Homebrew + chezmoi, then hands off to
# `chezmoi init --apply`. Fetched via `curl | bash` before the repo exists, so it
# inlines the brew-prefix probe ladder instead of sharing brew/shellenv (never derive
# the prefix from OS/arch — see docs/adr/0001-homebrew-prefix-discovery.md).

set -euo pipefail

# Cache a sudo credential now: Homebrew's NONINTERACTIVE installer only does a
# non-prompting sudo check and aborts instead of prompting if none is cached yet.
# Deliberately stays first, not after the install: NONINTERACTIVE=1 needs the
# credential warmed *before* it runs, so moving this later would break the installer
# on any machine without an already-cached credential. The SHA + checksum verification
# below is what actually closes the "unverified code with warm sudo" gap, not reordering.
sudo -v

fancy_echo() {
	local fmt="$1"
	shift

	# shellcheck disable=SC2059
	printf "\\n$fmt\\n" "$@"
}

# Homebrew's Linux prerequisites (it only prints the apt-get command, doesn't run it).
if command -v apt-get >/dev/null 2>&1; then
	fancy_echo "==> Installing Homebrew's Linux build dependencies…"
	sudo apt-get update -y
	sudo apt-get install -y build-essential bubblewrap procps curl file git
fi

# Install Homebrew if it is not already on PATH.
if ! command -v brew >/dev/null 2>&1; then
	fancy_echo "==> Installing Homebrew…"
	# Pinned to a specific commit + checksum, not HEAD — this is remote code executed
	# with sudo already cached above. Bump both together when Homebrew's installer
	# changes (no automation covers this one; it's not a GitHub Actions pin Renovate
	# tracks, and it isn't a mise-managed tool either).
	homebrew_installer_ref="39a0c068274254a7658fd9761d59bce9d0e2151f"
	homebrew_installer_sha256="8ff338091a5e10bb5fc040b38316648110f42feff057ecf9feaab51fd0a13ef9"
	homebrew_installer="$(mktemp)"
	trap 'rm -f "$homebrew_installer"' EXIT
	curl -fsSL "https://raw.githubusercontent.com/Homebrew/install/$homebrew_installer_ref/install.sh" -o "$homebrew_installer"
	# sha256sum (Linux/coreutils) vs shasum (macOS's built-in Perl one) — neither is
	# guaranteed on both platforms, so probe instead of assuming either.
	if command -v sha256sum >/dev/null 2>&1; then
		echo "$homebrew_installer_sha256  $homebrew_installer" | sha256sum -c - >/dev/null
	elif command -v shasum >/dev/null 2>&1; then
		echo "$homebrew_installer_sha256  $homebrew_installer" | shasum -a 256 -c - >/dev/null
	else
		fancy_echo "==> ERROR: no sha256sum or shasum available to verify the Homebrew installer"
		exit 1
	fi
	NONINTERACTIVE=1 /bin/bash "$homebrew_installer"
	rm -f "$homebrew_installer"
	trap - EXIT
fi

# Find the brew binary — never guess the prefix from arch (Linuxbrew/nix-homebrew live elsewhere).
BREW=""
for _brew in \
	"${HOMEBREW_PREFIX:-}/bin/brew" \
	/opt/homebrew/bin/brew \
	/usr/local/bin/brew \
	/home/linuxbrew/.linuxbrew/bin/brew; do
	if [ -x "$_brew" ]; then
		BREW="$_brew"
		break
	fi
done
unset _brew

if [ -z "$BREW" ]; then
	fancy_echo "==> ERROR: brew not found after install (checked \$HOMEBREW_PREFIX, /opt/homebrew, /usr/local, /home/linuxbrew/.linuxbrew)"
	exit 1
fi
eval "$("$BREW" shellenv)"

# Install chezmoi.
fancy_echo "==> Installing chezmoi…"
brew install chezmoi

# Applies the dotfiles and runs brew bundle; login shell is set separately per-platform.
fancy_echo "==> Applying dotfiles with chezmoi…"
chezmoi init --apply jeckhart/dotfiles

fancy_echo "==> Dotfiles now ready to go!"
