#!/bin/sh
# (Re)load the ssh-agent-bridge unit when its inputs change. The hashes/values
# below embed the unit source and the resolved npiperelay path into this
# script's content, so chezmoi re-runs it when either changes (e.g. npiperelay
# moves after a winget upgrade).
{{ if .isWSL2 -}}
# unit hash: {{ include "dot_config/systemd/user/ssh-agent-bridge.service.tmpl" | sha256sum }}
# npiperelay: {{ includeTemplate "ssh-agent-bridge/npiperelay-path" . | trim }}
set -eu
if [ ! -d /run/systemd/system ]; then
	echo "ssh-agent-bridge: systemd not enabled in WSL ([boot] systemd=true in /etc/wsl.conf); skipping" >&2
	exit 0
fi
if grep -q NPIPERELAY_NOT_FOUND "$HOME/.config/systemd/user/ssh-agent-bridge.service" 2>/dev/null; then
	echo "ssh-agent-bridge: npiperelay.exe was not installed when the unit rendered — re-run 'chezmoi apply'" >&2
	exit 0
fi
{{ includeTemplate "systemd/user-manager-probe" . }}
if ! systemd_user_bus_ok; then
	echo "ssh-agent-bridge: systemd user manager unreachable; see the wsl2-systemd-preflight diagnosis above. Skipping." >&2
	exit 0
fi
systemctl --user daemon-reload
loginctl enable-linger "$USER" 2>/dev/null || true
systemctl --user enable --now ssh-agent-bridge.service
systemctl --user try-restart ssh-agent-bridge.service || true
# Ubuntu's openssh-client ships a keyless per-user ssh-agent whose socket unit
# set-environments SSH_AUTH_SOCK over environment.d; mask it (--now stops it,
# which unsets the variable) before setting ours.
systemctl --user mask --now ssh-agent.socket ssh-agent.service 2>/dev/null || true
# environment.d needs a re-login to reach the user manager; set it now too so
# already-running managers (and services started this session) see the link.
systemctl --user set-environment "SSH_AUTH_SOCK=$HOME/.ssh/agent.sock"
# Resting default when the link is missing or dangling: the bridge, so
# non-interactive git finds an agent. A live link (e.g. a forwarded agent while
# applying over SSH) is left alone.
[ -d "$HOME/.ssh" ] || mkdir -m 700 "$HOME/.ssh"
[ -S "$HOME/.ssh/agent.sock" ] || ln -sf "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/ssh-agent.sock" "$HOME/.ssh/agent.sock" >/dev/null
echo "ssh-agent-bridge systemd user unit (re)loaded"
{{ else -}}
exit 0
{{ end -}}
