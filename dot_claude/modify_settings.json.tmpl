#!/bin/sh
# ~/.claude/settings.json — merged into, never overwritten. Claude Code rewrites this file at
# runtime (/advisor, /effort, /fast, /config), so chezmoi enforces only the keys named in $owned;
# everything else in $desired is a seed, written only when absent. Layering: seeds < live < owned.
# To manage another key, see docs/adr/0003-claude-code-settings-merge.md.
#
# hooks.PreToolUse is a THIRD layering, on top of seed/own: Claude Code's own Supacode
# integration and `bd prime` already populate that array at runtime, so neither seeding
# (dead — the key already exists live) nor owning (would delete their entries) works.
# Instead reconcile each chezmoi-managed hook — drop any prior entry whose command ends
# in $marker, or (for rtk) whose command is a known unmarked raw form that a plain
# `rtk init -g` would write by hand — then append the current set, leaving every other
# PreToolUse hook (Supacode, bd prime) untouched.
# See docs/adr/0005-agent-git-guardrails.md.
set -eu
{{ includeTemplate "brew/shellenv" . }}
current=$(cat)

# Keys chezmoi OWNS: re-enforced on every apply, overwriting runtime edits.
owned='["statusLine"]'

# Desired values. Keys named in $owned are enforced; all others here are SEEDS.
desired='{
	"tui": "fullscreen",
	"theme": "auto",
	"model": "opusplan",
	"statusLine": {
		"type": "command",
		"command": "bash ~/.claude/statusline-command.sh"
	}
}'

marker=' # chezmoi-managed-hook'
managed_hooks='[
	{"matcher":"Bash","hooks":[{"type":"command","command":"{{ .chezmoi.homeDir }}/.bin/agent-git-guard.zsh # chezmoi-managed-hook","timeout":10}]},
	{"matcher":"Bash","hooks":[{"type":"command","command":"{{ includeTemplate "brew/prefix" . }}/bin/rtk hook claude # chezmoi-managed-hook"}]}
]'
# `rtk init -g --agent claude` (run once to bootstrap this) writes this exact command
# with no marker — reconciled away below so a manual re-run never duplicates it.
stale_raw='["rtk hook claude"]'

if ! command -v jq >/dev/null 2>&1; then
	# Fresh bootstrap: Brewfile's jq isn't installed yet. Seed the file whole if absent,
	# otherwise pass it through rather than risk losing live settings. Skips the
	# hooks.PreToolUse reconciliation below too — it needs jq just as much as the guard
	# script itself does; the next apply (once jq is installed) picks it up.
	if [ -n "$current" ]; then
		printf '%s' "$current"
		echo "modify_settings.json: jq not found; left ~/.claude/settings.json unchanged" >&2
	else
		printf '%s\n' "$desired"
	fi
	exit 0
fi

[ -n "$current" ] || current='{}'

printf '%s' "$current" | jq \
	--argjson d "$desired" --argjson owned "$owned" \
	--arg marker "$marker" --argjson managed "$managed_hooks" --argjson stale "$stale_raw" '
	# Live-key-order-preserving merge: append only the seed keys the live file is
	# missing, rather than `$d * .` (recursive merge, live wins) — that emitted $d'"'"'s
	# keys first every time, hoisting tui/theme/model/statusLine to the top of the file
	# on every apply even though content never changed, so `chezmoi status` stayed
	# permanently dirty. `+` is shallow (not `*`'"'"'s recursive merge), which is fine here:
	# it only ever adds keys entirely absent from the live file.
	. as $live
	| ($live + ($d | with_entries(.key as $k | select(($live | has($k)) | not)))) as $merged
	| (reduce ($owned[]) as $k ($merged;
			if ($d | has($k)) then .[$k] = $d[$k] else . end)) as $enforced
	| $enforced
	| .hooks.PreToolUse = (
			([($enforced.hooks.PreToolUse // [])[]
				| select(
					((.hooks // []) | any(
						( (.command // "") as $c
							| ($c | endswith($marker)) or (($stale | index($c)) != null) )
					)) | not
				)
			])
			+ $managed
		)
'
