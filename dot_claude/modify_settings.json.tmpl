#!/bin/sh
# ~/.claude/settings.json — merged into, never overwritten. Claude Code rewrites this file at
# runtime (/advisor, /effort, /fast, /config), so chezmoi enforces only the keys named in $owned;
# everything else in $desired is a seed, written only when absent. Layering: seeds < live < owned.
# To manage another key, see docs/adr/0003-claude-code-settings-merge.md.
#
# Each hooks.<event> array named in $managed_hooks is a THIRD layering, on top of
# seed/own: other tools (`bd prime`, caveman) populate those arrays at runtime, so neither
# seeding (dead — the key already exists live) nor owning (would delete their entries)
# works. Instead reconcile each chezmoi-managed hook — drop any prior entry whose command
# ends in $marker, or whose command is a known unmarked raw form that a plain
# `rtk init -g` / `caveman hooks install` writes by hand — then append the current set,
# leaving every other hook in that array untouched. rtk is not wired, so its raw form is
# only ever removed.
# See docs/adr/0005-agent-git-guardrails.md and docs/adr/0008-hook-rewrites-and-worktree-isolation.md.
#
# Every managed hook runs under claude-hook-timer.zsh, which appends one line per run to
# ~/.local/state/claude-hooks/timing.log. The UserPromptSubmit entry is a sentinel with
# no command: it records spawn latency and load average when plugin hooks time out.
set -eu
{{ includeTemplate "brew/shellenv" . }}
current=$(cat)

# Keys chezmoi OWNS: re-enforced on every apply, overwriting runtime edits.
owned='["statusLine"]'

# Desired values. Keys named in $owned are enforced; all others here are SEEDS.
desired='{
	"tui": "fullscreen",
	"theme": "auto",
	"model": "opusplan",
	"statusLine": {
		"type": "command",
		"command": "bash ~/.claude/statusline-command.sh"
	}
}'

marker=' # chezmoi-managed-hook'
timer='{{ .chezmoi.homeDir }}/.bin/claude-hook-timer.zsh'
managed_hooks='{
	"PreToolUse": [
		{"matcher":"Bash","hooks":[{"type":"command","command":"'"$timer"' git-guard -- {{ .chezmoi.homeDir }}/.bin/agent-git-guard.zsh # chezmoi-managed-hook","timeout":10}]}
	],
	"UserPromptSubmit": [
		{"hooks":[{"type":"command","command":"'"$timer"' prompt-sentinel # chezmoi-managed-hook","timeout":5}]}
	]
}'
# `rtk init -g --agent claude` writes this exact command with no marker.
stale_raw='["rtk hook claude"]'
# `caveman hooks install claude` writes `<resolved caveman bin> shrink-hook` (any path,
# always ending in this exact suffix) with no marker — matched by suffix below, since
# the resolved path varies by machine, unlike rtk's PATH-relative form above.
stale_shrink_hook_suffix=' shrink-hook'

if ! command -v jq >/dev/null 2>&1; then
	# Fresh bootstrap: Brewfile's jq isn't installed yet. Seed the file whole if absent,
	# otherwise pass it through rather than risk losing live settings. Skips the
	# hooks.PreToolUse reconciliation below too — it needs jq just as much as the guard
	# script itself does; the next apply (once jq is installed) picks it up.
	if [ -n "$current" ]; then
		printf '%s' "$current"
		echo "modify_settings.json: jq not found; left ~/.claude/settings.json unchanged" >&2
	else
		printf '%s\n' "$desired"
	fi
	exit 0
fi

[ -n "$current" ] || current='{}'

printf '%s' "$current" | jq \
	--argjson d "$desired" --argjson owned "$owned" \
	--arg marker "$marker" --argjson managed "$managed_hooks" --argjson stale "$stale_raw" \
	--arg shrink_suffix "$stale_shrink_hook_suffix" '
	# Live-key-order-preserving merge: append only the seed keys the live file is
	# missing, rather than `$d * .` (recursive merge, live wins) — that emitted $d'"'"'s
	# keys first every time, hoisting tui/theme/model/statusLine to the top of the file
	# on every apply even though content never changed, so `chezmoi status` stayed
	# permanently dirty. `+` is shallow (not `*`'"'"'s recursive merge), which is fine here:
	# it only ever adds keys entirely absent from the live file.
	. as $live
	| ($live + ($d | with_entries(.key as $k | select(($live | has($k)) | not)))) as $merged
	| (reduce ($owned[]) as $k ($merged;
			if ($d | has($k)) then .[$k] = $d[$k] else . end)) as $enforced
	| reduce ($managed | keys_unsorted[]) as $event ($enforced;
		.hooks[$event] = (
			([(.hooks[$event] // [])[]
				| select(
					((.hooks // []) | any(
						( (.command // "") as $c
							| ($c | endswith($marker))
								or (($stale | index($c)) != null)
								or ($c | endswith($shrink_suffix)) )
					)) | not
				)
			])
			+ $managed[$event]
		))
'
