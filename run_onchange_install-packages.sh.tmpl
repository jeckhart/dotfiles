#!/bin/sh
# Install Homebrew dependencies. Re-runs automatically whenever the Brewfile
# changes, because chezmoi tracks the hash embedded in the comment below.
#
# Brewfile hash: {{ include "Brewfile" | sha256sum }}
set -e

{{ includeTemplate "brew/shellenv" . }}
# Brew may be absent on a not-yet-bootstrapped machine (see script/setup).
if ! command -v brew >/dev/null 2>&1; then
  echo "install-packages: brew not found, skipping 'brew bundle' — Brewfile packages will be missing" >&2
  exit 0
fi

brew bundle --file="{{ .chezmoi.sourceDir }}/Brewfile"
